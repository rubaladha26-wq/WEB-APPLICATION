# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Leave as memory or provide your Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/billing_db
MONGO_URI=memory

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_billing_2026_change_in_production
JWT_EXPIRE=7d

# Client URL (for CORS and reset password links)
CLIENT_URL=http://localhost:5173

# SMTP Email Configuration (Optional - Mailtrap/Sendgrid/Gmail)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=no-reply@nexusbill.com
FROM_NAME="Nexus Billing Solutions"

